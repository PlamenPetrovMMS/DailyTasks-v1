<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"

    android:focusable="true"
    android:focusableInTouchMode="true">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="30dp"
        android:layout_gravity="center"
        >
        <TextView
            android:id="@+id/editTaskNotifySettingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Send Notifications"
            android:fontFamily="@font/main_font"
            android:textColor="@color/white"
            android:textSize="30sp"

            android:layout_marginBottom="20dp"
            />

        <EditText
            android:id="@+id/editTaskHourResult"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/white_box"
            android:padding="5dp"
            android:inputType="number"

            android:text="10"
            android:textColor="@color/black"
            android:fontFamily="@font/main_font"
            android:textSize="30sp"

            android:focusable="true"
            android:focusableInTouchMode="true"

            android:layout_below="@+id/editTaskNotifySettingLabel"
            android:layout_marginBottom="10dp"

            android:maxLength="1"
            />

        <TextView
            android:id="@+id/editTaskHourLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="hours"
            android:fontFamily="@font/main_font"
            android:textColor="@color/white"
            android:textSize="20sp"

            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/editTaskHourResult"
            android:layout_alignBottom="@+id/editTaskHourResult"
            />

        <EditText
            android:id="@+id/editTaskMinuteResult"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:background="@drawable/white_box"
            android:padding="5dp"
            android:inputType="number"

            android:text="5"
            android:textColor="@color/black"
            android:fontFamily="@font/main_font"
            android:textSize="30sp"

            android:focusable="true"
            android:focusableInTouchMode="true"

            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/editTaskHourLabel"
            android:layout_alignBottom="@+id/editTaskHourLabel"

            android:maxLength="2"
            />

        <TextView
            android:id="@+id/editTaskMinuteLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="minutes"
            android:fontFamily="@font/main_font"
            android:textColor="@color/white"
            android:textSize="20sp"

            android:layout_marginStart="4dp"
            android:layout_toEndOf="@+id/editTaskMinuteResult"
            android:layout_alignBottom="@+id/editTaskMinuteResult"
            />


    </RelativeLayout>
</RelativeLayout>